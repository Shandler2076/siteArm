# Copier ce fichier en .env (jamais envoyé sur GitHub) et adapter les valeurs.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=a-remplacer-par-une-longue-cle-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=sqlite:///db.sqlite3
DJANGO_SITE_URL=http://127.0.0.1:8000
DJANGO_DEFAULT_FROM_EMAIL=Armée du Salut <noreply@localhost>
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True

# Double vérification des comptes du BN (laisser True en production)
DJANGO_DOUBLE_VERIFICATION_BN=True

# Hébergement (voir docs/guide-alwaysdata.md)
# Dossier des photos privées (hors du code) :
DJANGO_PRIVATE_MEDIA_ROOT=
# Mettre False seulement si l'hébergeur redirige déjà vers HTTPS (boucle de redirections) :
DJANGO_SECURE_SSL_REDIRECT=True
# Site d'essai : bandeau « données fictives » et commande peupler_demo (JAMAIS sur le vrai site) :
DJANGO_SITE_DEMO=False

# Contact affiché sur la page « Protection de vos données » (e-mail ou téléphone du BNC) :
DJANGO_CONTACT_DONNEES=
